{
  "name": "dshx-skill-manager",
  "version": "1.0.0",
  "description": "A DSH settings page listing installed skills with per-skill enable switches and short summaries.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "author": "callaumyan-design",
  "license": "MIT",
  "homepage": "https://github.com/callaumyan-design/dshx-skill-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callaumyan-design/dshx-skill-manager.git"
  },
  "bugs": {
    "url": "https://github.com/callaumyan-design/dshx-skill-manager/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "index.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "marketplace": {
      "profiles": [
        "web",
        "desktop"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  }
}
